{
  "compilerOptions": {
    "outDir": "dist/esm",
    "rootDir": "src",
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "baseUrl": ".",
    "declaration": true,           // gera .d.ts
    "declarationMap": true,        // opcional, útil em debug
    "emitDeclarationOnly": false, 
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}