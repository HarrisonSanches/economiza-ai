{
  "name": "economiza-ai-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@economiza/api",
    "dev:app": "turbo run dev --filter=@economiza/app",
    "dev:notifications": "turbo run dev --filter=@economiza/notifications",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "5.4.5",
    "prettier": "latest"
  },
  "packageManager": "bun@1.2.10"
}